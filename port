
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Flipbook Viewer</title>

  <!-- Flipbook styling -->
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f7f7f5;
      color: #222;
      font-family: Arial, sans-serif;
    }

    .viewer {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px 12px;
    }

    #book-container {
      width: 100%;
      min-height: 320px;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }

    #book {
      margin: 0 auto;
    }

    #book canvas {
      display: block;
    }

    .controls {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-top: 22px;
      font-size: 12px;
    }

    .controls button,
    .controls a {
      font: inherit;
      color: inherit;
      background: transparent;
      border: 1px solid #bbb;
      padding: 8px 13px;
      text-decoration: none;
      cursor: pointer;
    }

    .controls button:hover,
    .controls a:hover {
      background: #e9e9e6;
    }

    .controls button:disabled {
      opacity: 0.35;
      cursor: default;
    }

    #status {
      text-align: center;
      font-size: 12px;
      padding: 24px 8px;
    }

    @media (max-width: 600px) {
      .viewer {
        padding: 12px 4px;
      }

      .controls {
        gap: 8px;
      }
    }
  </style>
</head>

<body>
  <main class="viewer">
    <div id="status">Loading publication...</div>

    <div id="book-container">
      <div id="book"></div>
    </div>

    <nav class="controls" aria-label="Flipbook controls">
      <button id="previous" disabled>Previous</button>
      <span id="page-number">Page —</span>
      <button id="next" disabled>Next</button>
      <button id="fullscreen">Fullscreen</button>
      <a id="open-pdf" target="_blank"
         rel="noopener noreferrer">Open PDF</a>
    </nav>
  </main>

  <!-- PDF.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

  <!-- StPageFlip -->
  <script src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.js"></script>

  <script>
    // REPLACE THIS with the public URL of your PDF.
    const PDF_URL = "https://freight.cargo.site/m/J3176458499584921161525578629685/Anderson_Loudmouth-compressed.pdf";

    const status = document.getElementById("status");
    const bookElement = document.getElementById("book");
    const container = document.getElementById("book-container");
    const previousButton = document.getElementById("previous");
    const nextButton = document.getElementById("next");
    const pageNumber = document.getElementById("page-number");
    const fullscreenButton = document.getElementById("fullscreen");
    const openPdf = document.getElementById("open-pdf");

    openPdf.href = PDF_URL;

    pdfjsLib.GlobalWorkerOptions.workerSrc =
      "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

    let flipbook = null;
    let totalPages = 0;

    function updateControls() {
      if (!flipbook) return;

      const current = flipbook.getCurrentPageIndex();

      pageNumber.textContent =
        "Page " + (current + 1) + " of " + totalPages;

      previousButton.disabled = current <= 0;
      nextButton.disabled = current >= totalPages - 1;
    }

    async function createFlipbook() {
      try {
        const pdf = await pdfjsLib.getDocument(PDF_URL).promise;
        totalPages = pdf.numPages;

        const images = [];
        const maxPageWidth = 900;

        // Render each PDF page to an image.
        for (let i = 1; i <= totalPages; i++) {
          status.textContent =
            "Preparing page " + i + " of " + totalPages + "...";

          const page = await pdf.getPage(i);
          const originalViewport = page.getViewport({ scale: 1 });
          const scale = Math.min(
            maxPageWidth / originalViewport.width,
            1.5
          );
          const viewport = page.getViewport({ scale });

          const canvas = document.createElement("canvas");
          const context = canvas.getContext("2d");

          canvas.width = Math.floor(viewport.width);
          canvas.height = Math.floor(viewport.height);

          await page.render({
            canvasContext: context,
            viewport: viewport
          }).promise;

          images.push(canvas.toDataURL("image/jpeg", 0.88));

          canvas.width = 0;
          canvas.height = 0;
        }

        // Use the PDF's page proportions for the book.
        const firstPage = await pdf.getPage(1);
        const dimensions = firstPage.getViewport({ scale: 1 });
        const pageWidth = 500;
        const pageHeight =
          pageWidth * dimensions.height / dimensions.width;

        bookElement.innerHTML = "";

        flipbook = new St.PageFlip(bookElement, {
          width: pageWidth,
          height: pageHeight,
          size: "stretch",
          minWidth: 250,
          maxWidth: pageWidth,
          minHeight: 320,
          maxHeight: pageHeight,
          maxShadowOpacity: 0.25,
          showCover: true,
          usePortrait: true,
          mobileScrollSupport: true,
          drawShadow: true,
          flippingTime: 700,
          autoSize: true
        });

        flipbook.loadFromImages(images);
        flipbook.on("flip", updateControls);

        status.style.display = "none";
        previousButton.disabled = false;
        nextButton.disabled = false;
        updateControls();

      } catch (error) {
        console.error(error);
        status.textContent =
          "Unable to load the PDF. Check the URL and hosting permissions.";
      }
    }

    previousButton.addEventListener("click", () => {
      if (flipbook) flipbook.flipPrev();
    });

    nextButton.addEventListener("click", () => {
      if (flipbook) flipbook.flipNext();
    });

    fullscreenButton.addEventListener("click", async () => {
      const target = document.querySelector(".viewer");

      try {
        if (!document.fullscreenElement) {
          await target.requestFullscreen();
        } else {
          await document.exitFullscreen();
        }
      } catch (error) {
        console.error("Fullscreen is unavailable:", error);
      }
    });

    createFlipbook();
  </script>
</body>
</html>
